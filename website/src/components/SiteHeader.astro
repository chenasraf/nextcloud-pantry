---
import { Image } from 'astro:assets'
import icon from '../assets/pantry-icon.png'
---

<header class="site-header">
	<div class="shell site-header__inner">
		<a class="brand" href="/">
			<Image src={icon} alt="" width={30} height={30} class="brand__icon" />
			<span class="brand__word">Pantry</span>
			<span class="brand__pill">docs</span>
		</a>
		<nav class="site-nav">
			<a href="/#features">Features</a>
			<a href="/docs">Docs</a>
			<a href="/#download">Download</a>
			<a
				class="site-nav__gh"
				href="https://github.com/chenasraf/nextcloud-pantry"
				aria-label="Pantry on GitHub"
			>
				<svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
					></path>
				</svg>
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg-page) 82%, transparent);
		backdrop-filter: saturate(140%) blur(10px);
		border-bottom: 1px solid var(--rule);
	}
	.site-header__inner {
		display: flex;
		align-items: center;
		gap: 14px;
		height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.brand__icon {
		border-radius: 7px;
	}
	.brand__word {
		font-family: var(--font-display);
		font-size: 18px;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--text-strong);
	}
	.brand__pill {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--pantry-blue-300);
		background: rgba(0, 130, 201, 0.12);
		border: 1px solid rgba(0, 130, 201, 0.3);
		border-radius: var(--r-pill);
		padding: 3px 9px;
	}
	.site-nav {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 22px;
		font-size: 14px;
		color: var(--text);
	}
	.site-nav a {
		color: var(--text);
		transition: color var(--dur-fast) var(--ease);
	}
	.site-nav a:hover {
		color: var(--text-strong);
	}
	.site-nav__gh {
		display: inline-flex;
		color: var(--text-muted);
	}
	@media (max-width: 640px) {
		.brand__pill {
			display: none;
		}
		.site-nav {
			gap: 16px;
			font-size: 13px;
		}
		.site-nav a:not(.site-nav__gh) {
			display: none;
		}
	}
</style>

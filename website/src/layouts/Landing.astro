---
import '../styles/landing.css'

interface Props {
	title?: string
	description?: string
}

const {
	title = 'Pantry — the household list app that lives in your Nextcloud',
	description = 'Checklists, a photo board and a notes wall — shared with the people you live with, synced to a server you own.',
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/brand/pantry-icon.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="theme-color" content="#0b0c0e" />
	</head>
	<body>
		<slot />
	</body>
</html>

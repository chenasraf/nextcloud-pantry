<?xml version="1.0"?>
<psalm
    errorLevel="1"
    resolveFromConfigFile="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedCode="true"
    findUnusedBaselineEntry="true"
>
    <projectFiles>
        <directory name="lib" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <stubs>
        <file name="tests/stubs/oc.phpstub" />
    </stubs>
	<extraFiles>
		<directory name="vendor"/>
	</extraFiles>

    <issueHandlers>
        <!--
            Psalm believes OCP's docblocks, and several of them describe a
            stricter type than the implementation returns. The casts and guards
            it calls redundant are what keep those cases from crashing:

              - `Entity` declares `@method int getId()` while `$id` is null
                until the row is inserted, so `(int)$entity->getId()` is doing
                real work on unsaved entities.
              - `IRequest::getUploadedFile()` is declared `@return array` but
                returns null when the key is absent, so the null check stands.
              - A `@param list<int>`/`list<string>` is a promise from the caller,
                not something PHP enforces. Values reaching these functions come
                from request JSON, so they are normalised on arrival.
        -->
        <RedundantCastGivenDocblockType errorLevel="suppress" />
        <RedundantConditionGivenDocblockType errorLevel="suppress" />
        <DocblockTypeContradiction errorLevel="suppress" />
        <RedundantFunctionCall errorLevel="suppress" />

        <!--
            Nothing in this app is wired up by a call psalm can see. Classes are
            named in appinfo/info.xml, reached through route attributes, or built
            by the DI container; entity properties are read and written through
            `Entity::__call`, and `Entity::$id` is populated by the mapper rather
            than a constructor. Controller actions must also declare every route
            and request parameter in their signature, whether the body reads them
            or the OpenAPI spec does.
        -->
        <UnusedClass errorLevel="suppress" />
        <PossiblyUnusedMethod errorLevel="suppress" />
        <PossiblyUnusedProperty errorLevel="suppress" />
        <PossiblyUnusedReturnValue errorLevel="suppress" />
        <PossiblyUnusedParam errorLevel="suppress" />
        <UnusedParam errorLevel="suppress" />
        <PropertyNotSetInConstructor errorLevel="suppress" />

        <!--
            The response types in ResponseDefinitions narrow fields to literal
            unions (icon and colour palettes, enum-like strings) so the generated
            OpenAPI spec gives clients real enums. Entities store those columns as
            plain strings, so the declared shape is deliberately more precise than
            anything psalm can derive from the entity.
        -->
        <MoreSpecificReturnType errorLevel="suppress" />
        <LessSpecificReturnStatement errorLevel="suppress" />
        <MixedReturnTypeCoercion errorLevel="suppress" />

        <!--
            Request payloads arrive as `array<string, mixed>`. Reading a key into
            a variable and then narrowing it with is_string()/is_int() is the
            pattern used throughout the services, and the assignment itself is
            the step psalm objects to.
        -->
        <MixedAssignment errorLevel="suppress" />
    </issueHandlers>
</psalm>

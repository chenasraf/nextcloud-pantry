{
  "name": "pantry",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0",
    "pnpm": "^11.9.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint src",
    "format": "eslint --fix src && prettier --write {vite.config.ts,src/,README.md}",
    "prepare": "lefthook install",
    "gen": "simple-scaffold -c . -k",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^7.5.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vite-config": "^2.5.4",
    "@nextcloud/vue": "^9.11.0",
    "barcode-detector": "^3.2.2",
    "date-fns": "^4.4.0",
    "fuzzball": "^2.2.6",
    "linkifyjs": "^4.3.3",
    "rrule": "^2.8.1",
    "vue": "^3.5.42",
    "vue-material-design-icons": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.12",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.103.1",
    "sass-embedded": "^1.103.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-checker": "^0.14.5",
    "vitest": "^4.1.11",
    "vue-router": "^5.3.0",
    "vue-tsc": "^3.3.11"
  }
}
